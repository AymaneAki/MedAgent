# MedAgent Configuration - Environment Variables

# ── Primary Local LLM (BitNet via llama.cpp / Ollama) ──
BITNET_BASE_URL=http://localhost:11434
BITNET_MODEL=bitnet-b1.58-2b-4t

# ── Fallback Cloud APIs (Optional - for resilience) ──
# If the local BitNet server is offline, these will be checked
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# ── Application Configuration ──
LOG_LEVEL=INFO
DEFAULT_GENDER=default
OUTPUT_DIR=output/summaries

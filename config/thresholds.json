{
  "_metadata": {
    "version": "1.0",
    "sources": [
      "WHO International Laboratory Standards (ISO 15189:2012)",
      "ABIM Laboratory Reference Ranges 2024",
      "LabPedia Critical/Panic Values",
      "StatPearls - Normal CBC Reference Intervals (NCBI, 2024)"
    ],
    "note": "Reference ranges are for adults (18-65 years). Gender-specific ranges noted where applicable. Always validate against local laboratory standards.",
    "units_convention": "SI units preferred"
  },

  "hematology": {

    "hemoglobine": {
      "label": "Hémoglobine",
      "unit": "g/dL",
      "gender_specific": true,
      "normal": {
        "male":   { "min": 13.5, "max": 17.5 },
        "female": { "min": 12.0, "max": 16.0 },
        "default":{ "min": 12.0, "max": 17.5 }
      },
      "critical_low": 7.0,
      "critical_high": 20.0,
      "clinical_risk_low": "Anémie sévère — risque d'insuffisance cardiaque, transfusion à envisager",
      "clinical_risk_high": "Polyglobulie — risque thrombotique"
    },

    "hematocrite": {
      "label": "Hématocrite",
      "unit": "%",
      "gender_specific": true,
      "normal": {
        "male":   { "min": 41, "max": 53 },
        "female": { "min": 36, "max": 46 },
        "default":{ "min": 36, "max": 53 }
      },
      "critical_low": 20,
      "critical_high": 60,
      "clinical_risk_low": "Anémie profonde",
      "clinical_risk_high": "Hyperviscosité sanguine"
    },

    "leucocytes": {
      "label": "Leucocytes (GB)",
      "unit": "G/L",
      "gender_specific": false,
      "normal": { "min": 4.0, "max": 10.0 },
      "critical_low": 1.0,
      "critical_high": 30.0,
      "clinical_risk_low": "Leucopénie sévère — immunodépression, risque infectieux majeur",
      "clinical_risk_high": "Hyperleucocytose — possible leucémie ou infection sévère"
    },

    "plaquettes": {
      "label": "Plaquettes",
      "unit": "G/L",
      "gender_specific": false,
      "normal": { "min": 150, "max": 400 },
      "critical_low": 50,
      "critical_high": 1000,
      "clinical_risk_low": "Thrombopénie sévère — risque hémorragique spontané",
      "clinical_risk_high": "Thrombocytose — risque thrombotique"
    },

    "vgm": {
      "label": "Volume Globulaire Moyen (VGM)",
      "unit": "fL",
      "gender_specific": false,
      "normal": { "min": 80, "max": 100 },
      "critical_low": null,
      "critical_high": null,
      "clinical_risk_low": "Microcytose — carence martiale probable",
      "clinical_risk_high": "Macrocytose — carence B12/folate, alcoolisme"
    },

    "neutrophiles": {
      "label": "Polynucléaires Neutrophiles",
      "unit": "G/L",
      "gender_specific": false,
      "normal": { "min": 1.8, "max": 7.5 },
      "critical_low": 0.5,
      "critical_high": 20.0,
      "clinical_risk_low": "Neutropénie sévère (agranulocytose) — risque infectieux vital",
      "clinical_risk_high": "Hyperneutrophilie — infection bactérienne sévère"
    },

    "lymphocytes": {
      "label": "Lymphocytes",
      "unit": "G/L",
      "gender_specific": false,
      "normal": { "min": 1.0, "max": 4.0 },
      "critical_low": 0.5,
      "critical_high": 15.0,
      "clinical_risk_low": "Lymphopénie — immunodépression",
      "clinical_risk_high": "Hyperlymphocytose — leucémie lymphoïde possible"
    }
  },

  "biochemistry": {

    "glucose": {
      "label": "Glycémie (à jeun)",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 3.9, "max": 6.1 },
      "critical_low": 2.5,
      "critical_high": 25.0,
      "clinical_risk_low": "Hypoglycémie sévère — coma hypoglycémique imminent",
      "clinical_risk_high": "Hyperglycémie majeure — acidocétose ou coma hyperosmolaire"
    },

    "sodium": {
      "label": "Sodium (Natrémie)",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 136, "max": 145 },

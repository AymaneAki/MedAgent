    },

    "bnp": {
      "label": "BNP (Peptide natriurétique)",
      "unit": "pg/mL",
      "gender_specific": false,
      "normal": { "min": 0, "max": 100 },
      "critical_low": null,
      "critical_high": 400,
      "clinical_risk_high": "Insuffisance cardiaque décompensée"

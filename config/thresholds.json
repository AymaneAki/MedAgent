      "critical_high": 155,
      "clinical_risk_low": "Hyponatrémie sévère — œdème cérébral, convulsions",
      "clinical_risk_high": "Hypernatrémie sévère — déshydratation cérébrale, effondrement cardiovasculaire"
    },

    "potassium": {
      "label": "Potassium (Kaliémie)",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 3.5, "max": 5.0 },
      "critical_low": 2.8,
      "critical_high": 6.5,
      "clinical_risk_low": "Hypokaliémie sévère — arythmie cardiaque, arrêt cardiaque",
      "clinical_risk_high": "Hyperkaliémie sévère — fibrillation ventriculaire, arrêt cardiaque"
    },

    "creatinine": {
      "label": "Créatinine",
      "unit": "µmol/L",
      "gender_specific": true,
      "normal": {
        "male":   { "min": 62, "max": 115 },
        "female": { "min": 44, "max": 97 },
        "default":{ "min": 44, "max": 115 }
      },
      "critical_low": null,
      "critical_high": 500,
      "clinical_risk_high": "Insuffisance rénale aiguë sévère — dialyse en urgence à envisager"
    },

    "uree": {
      "label": "Urée",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 2.5, "max": 7.5 },
      "critical_low": null,
      "critical_high": 35.0,
      "clinical_risk_high": "Urémie sévère — encéphalopathie urémique"
    },

    "calcium": {
      "label": "Calcium total",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 2.15, "max": 2.55 },
      "critical_low": 1.75,
      "critical_high": 3.25,
      "clinical_risk_low": "Hypocalcémie sévère — tétanie, convulsions",
      "clinical_risk_high": "Hypercalcémie sévère — cardiotoxicité, coma"
    },

    "magnesium": {
      "label": "Magnésium",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 0.75, "max": 1.05 },
      "critical_low": 0.5,
      "critical_high": 2.0,
      "clinical_risk_low": "Hypomagnésémie — tétanie, arythmie",
      "clinical_risk_high": "Hypermagnésémie — paralysie respiratoire, arrêt cardiaque"
    },

    "phosphore": {
      "label": "Phosphore",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 0.87, "max": 1.45 },
      "critical_low": 0.3,
      "critical_high": null,
      "clinical_risk_low": "Hypophosphatémie sévère — dysfonction musculaire, insuffisance respiratoire"
    },

    "chlore": {
      "label": "Chlore (Chlorémie)",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 98, "max": 106 },
      "critical_low": 70,
      "critical_high": 120,
      "clinical_risk_low": "Hypochlorémie — alcalose métabolique, vomissements sévères",
      "clinical_risk_high": "Hyperchlorémie — acidose hyperchlorémique"
    },

    "bicarbonate": {
      "label": "Bicarbonate (HCO3-)",
      "unit": "mmol/L",
      "gender_specific": false,
      "normal": { "min": 22, "max": 29 },
      "critical_low": 10,
      "critical_high": 40,
      "clinical_risk_low": "Acidose métabolique sévère",
      "clinical_risk_high": "Alcalose métabolique sévère — troubles respiratoires"
    }
  },

  "liver_function": {

    "alat": {
      "label": "ALAT (SGPT)",
      "unit": "U/L",
      "gender_specific": false,
      "normal": { "min": 7, "max": 56 },
      "critical_low": null,
      "critical_high": 1000,
      "clinical_risk_high": "Cytolyse hépatique massive — hépatite aiguë sévère"
    },

    "asat": {
      "label": "ASAT (SGOT)",
      "unit": "U/L",
      "gender_specific": false,
      "normal": { "min": 10, "max": 40 },
      "critical_low": null,
      "critical_high": 1000,
      "clinical_risk_high": "Cytolyse hépatique ou musculaire massive"
    },

    "bilirubine_totale": {
      "label": "Bilirubine totale",
      "unit": "µmol/L",
      "gender_specific": false,
      "normal": { "min": 3, "max": 21 },
      "critical_low": null,
      "critical_high": 340,
      "clinical_risk_high": "Ictère sévère — insuffisance hépatique ou obstruction biliaire"

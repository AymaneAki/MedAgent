      "label": "Albumine",
      "unit": "g/L",
      "gender_specific": false,
      "normal": { "min": 35, "max": 52 },
      "critical_low": 20,
      "critical_high": null,
      "clinical_risk_low": "Hypoalbuminémie sévère — dénutrition, insuffisance hépatique"
    },

    "ggt": {
      "label": "Gamma GT (GGT)",
      "unit": "U/L",
      "gender_specific": true,
      "normal": {
        "male":   { "min": 8, "max": 61 },
        "female": { "min": 5, "max": 36 },
        "default":{ "min": 5, "max": 61 }
      },
      "critical_low": null,
      "critical_high": null,
      "clinical_risk_high": "Cholestase ou intoxication alcoolique"
    }
